rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function unlocked(dropId) {
      return signedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/opened/$(dropId)) ||
        get(/databases/$(database)/documents/drops/$(dropId)).data.authorId == request.auth.uid
      );
    }

    // 予告・位置・範囲・数字は誰でも読める。書き込みは Cloud Functions 経由のみ。
    match /drops/{dropId} {
      allow read: if true;
      allow write: if false;

      // 本文と写真の場所。クライアントからは読めない（openDrop が距離を確かめて返す）。
      match /private/{doc} {
        allow read, write: if false;
      }

      // その場所でひらいた人と投稿者だけが読めるコメント。
      match /comments/{commentId} {
        allow read: if unlocked(dropId);
        allow write: if false;
      }
    }

    // イベント（巡りルート）。誰でも見られる。
    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // みんなの踏み跡（マス目ごとの回数だけ。誰が通ったかは持たない）。
    match /footprints/{cellId} {
      allow read: if true;
      allow write: if false;
    }

    // 公開プロフィール（名前と数字だけ）。
    match /profiles/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // 自分の記録・いいね・お知らせ。本人だけが読める。
    match /users/{uid}/{document=**} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
