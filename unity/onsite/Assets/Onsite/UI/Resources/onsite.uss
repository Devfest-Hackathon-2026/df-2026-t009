/* 地図の余白に、文字と光だけを置く。 */
.onsite, .onsite-root {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    color: #EAFBFF; font-size: 24px;
    -unity-font-definition: url("project://database/Assets/Onsite/Fonts/ZenKakuGothicNew-Medium.ttf");
}
Label { white-space: normal; text-shadow: 0 2px 8px rgba(2,6,10,0.85); }
.unity-button {
    margin: 0; padding: 12px 18px; min-height: 58px;
    border-width: 0; border-radius: 0; background-color: rgba(0,0,0,0);
    color: #EAFBFF; -unity-text-align: middle-left;
    -unity-font-definition: url("project://database/Assets/Onsite/Fonts/ZenKakuGothicNew-Medium.ttf");
    text-shadow: 0 2px 7px rgba(2,6,10,0.85);
    transition-property: background-color, color; transition-duration: 140ms;
}
.unity-button:hover { color: #7FE3FF; background-color: rgba(127,227,255,0.06); }
.unity-button:active, .unity-button.laser-flash { color: #EAFBFF; background-color: rgba(127,227,255,0.20); }
.unity-button:focus { border-bottom-width: 1px; border-bottom-color: #FFB24A; }
.unity-button:disabled { color: #7FA3AB; opacity: 0.55; }
.button { margin-top: 8px; flex-shrink: 0; }
.primary {
    padding: 16px 24px; min-height: 68px; overflow: hidden;
    color: #EAFBFF; letter-spacing: 2px;
    border-bottom-width: 1px; border-bottom-color: rgba(160,230,255,0.35);
    background-color: rgba(46,155,214,0.10);
}
.primary > .laser-band { position: absolute; left: 0; right: 0; top: 0; height: 20px; margin: 0; }
.primary:hover { background-color: rgba(46,155,214,0.20); }
.primary:active, .primary.laser-flash { background-color: rgba(127,227,255,0.32); }
.primary.amber, .amber { color: #FFB24A; }
.danger { color: #FF6B5A; }
.muted, .caption { color: #7FA3AB; }
.caption { font-size: 19px; margin-top: 8px; margin-bottom: 16px; }
.mono, .unity-text-field__input.mono {
    -unity-font-definition: url("project://database/Assets/Onsite/Fonts/ShareTechMono-Regular.ttf");
    letter-spacing: 1px;
}
.section-label, .caption-en, .rail-label {
    -unity-font-definition: url("project://database/Assets/Onsite/Fonts/ShareTechMono-Regular.ttf");
    font-size: 18px; letter-spacing: 2px; color: #7FA3AB;
}
.heading, .title { font-size: 34px; margin-top: 14px; margin-bottom: 18px; }
.subtitle { font-size: 23px; color: #7FA3AB; margin-bottom: 24px; }
.body-copy { font-size: 26px; white-space: normal; margin-top: 16px; margin-bottom: 28px; -unity-paragraph-spacing: 12px; }
.row, .toolbar, .action-row, .choice-row, .picker-row, .stats-grid, .stat-grid { flex-direction: row; }
.row { align-items: center; }
.toolbar, .action-row { flex-wrap: wrap; margin-top: 12px; margin-bottom: 22px; }
.action-row > *, .toolbar > * { margin-right: 12px; }
.fade-surface { position: absolute; left: -24px; right: -32px; top: -24px; bottom: -24px; }
.laser-band { height: 14px; min-height: 14px; flex-shrink: 0; margin-top: 8px; margin-bottom: 12px; }
.hud-panel { position: relative; padding: 24px 28px; min-height: 0; background-color: rgba(0,0,0,0); }
.panel-header { flex-direction: row; align-items: center; flex-shrink: 0; flex-wrap: wrap; min-height: 60px; }
.panel-heading {
    -unity-font-definition: url("project://database/Assets/Onsite/Fonts/BarlowCondensed-Light.ttf");
    font-size: 48px; letter-spacing: 10px; color: #EAFBFF;
}
.panel-title { font-size: 21px; color: #7FA3AB; margin-left: 20px; flex-grow: 1; }
.panel-rule { height: 12px; min-height: 12px; margin-bottom: 22px; margin-top: 3px; }
.panel-body { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.panel-corners { display: none; }
.close-button { flex-direction: row; align-items: center; min-height: 44px; font-size: 19px; color: #7FA3AB; padding: 4px 0 4px 16px; margin-top: 0; margin-left: auto; }
.close-button .line-icon { width: 22px; height: 22px; margin-right: 10px; }
.screen-layer, .map-hud, .world-tags { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.screen { position: absolute; top: 236px; bottom: 46px; left: 152px; right: 48px; max-width: 1040px; }
.screen > .hud-panel { flex-grow: 1; min-height: 0; }
.screen-scroll { flex-grow: 1; min-height: 0; }
.screen-scroll .unity-scroll-view__content-container { padding-right: 18px; padding-bottom: 48px; }
.unity-scroller--vertical { width: 5px; min-width: 5px; background-color: rgba(127,227,255,0.025); }
.unity-scroller__slider .unity-base-slider__dragger { background-color: rgba(127,227,255,0.28); border-width: 0; border-radius: 0; }
.unity-scroller__low-button, .unity-scroller__high-button { display: none; }
.field { margin-top: 18px; margin-bottom: 24px; flex-direction: column; flex-shrink: 0; }
.field > .unity-base-field__label { color: #7FA3AB; font-size: 20px; margin-bottom: 10px; min-width: 0; }
.field .unity-text-field__input {
    background-color: rgba(4,10,16,0.30); color: #EAFBFF; padding: 14px 12px;
    border-width: 0; border-bottom-width: 1px; border-bottom-color: rgba(160,230,255,0.35); border-radius: 0;
    -unity-font-definition: url("project://database/Assets/Onsite/Fonts/ZenKakuGothicNew-Medium.ttf");
    min-height: 60px; white-space: normal;
}
.field .unity-text-field__input:focus { border-bottom-color: #7FE3FF; background-color: rgba(46,155,214,0.08); }
.field.multiline .unity-text-field__input { min-height: 180px; }
.unity-toggle { margin-top: 18px; margin-bottom: 18px; min-height: 48px; flex-shrink: 0; }
.unity-toggle__label { flex-grow: 1; color: #EAFBFF; }
.unity-toggle__input { background-color: rgba(127,227,255,0.04); border-color: rgba(160,230,255,0.35); min-width: 30px; min-height: 30px; }
.picker { margin-top: 18px; margin-bottom: 22px; flex-shrink: 0; }
.picker-row, .choice-row { flex-wrap: wrap; margin-top: 8px; }
.picker-option, .choice { flex-grow: 1; margin-right: 12px; margin-bottom: 8px; padding: 12px; font-size: 21px; border-bottom-width: 1px; border-bottom-color: rgba(160,230,255,0.18); }
.picker-option.selected, .picker-option.on, .choice.selected, .choice.on, .segmented .selected, .segmented .on, Button.selected {
    color: #7FE3FF; background-color: rgba(46,155,214,0.10); border-bottom-width: 1px; border-bottom-color: #7FE3FF;
}
.card, .data-card { margin-top: 12px; margin-bottom: 30px; padding: 20px 0 30px; border-bottom-width: 1px; border-bottom-color: rgba(160,230,255,0.20); flex-shrink: 0; }
.card:hover, .data-card:hover { background-color: rgba(127,227,255,0.025); }
.card:focus, .data-card:focus, .table-row:focus { border-bottom-color: #FFB24A; }
.unread { border-left-width: 2px; border-left-color: #FFB24A; padding-left: 20px; }
.empty { color: #7FA3AB; padding: 36px 4px; font-size: 24px; white-space: normal; }
.author-line { min-height: 50px; margin-top: 12px; margin-bottom: 18px; flex-shrink: 0; flex-wrap: wrap; }
.author-avatar { width: 42px; height: 42px; border-radius: 21px; border-width: 1px; border-color: rgba(160,230,255,0.35); align-items: center; justify-content: center; margin-right: 14px; }
.author-avatar .line-icon { width: 24px; height: 24px; }
.author-name { font-size: 22px; }
.author-time { margin-left: auto; padding-left: 14px; color: #7FA3AB; font-size: 18px; }
.photo, .letter-photo, .post-preview {
    width: 100%; height: 500px; min-height: 0; flex-shrink: 0;
    margin-top: 8px; margin-bottom: 28px; border-radius: 18px; overflow: hidden; background-color: rgba(4,10,16,0.20);
}
.letter-media { width: 100%; border-radius: 18px; overflow: hidden; flex-shrink: 0; margin-top: 12px; margin-bottom: 16px; }
.letter-media .letter-photo { margin: 0; border-radius: 0; }
.content-toolbar { flex-wrap: wrap; margin-bottom: 12px; flex-shrink: 0; }
.content-toolbar > Button { margin-right: 18px; border-bottom-width: 1px; border-bottom-color: rgba(160,230,255,0.18); }
.content-toolbar > Button.on { color: #7FE3FF; border-bottom-color: #7FE3FF; }
.feed-card .signal-meta { justify-content: space-between; margin-bottom: 16px; }
.feed-card .heading, .feed-teaser { font-size: 38px; margin-top: 14px; margin-bottom: 22px; }
.feed-caption, .photo-caption { font-size: 18px; color: #7FA3AB; margin-bottom: 18px; }
.feed-identity, .feed-header { justify-content: space-between; }
.feed-distance { font-size: 28px; color: #7FE3FF; margin-left: auto; }
.feed-actions { margin-top: 12px; justify-content: space-between; flex-wrap: wrap; }
.photo-preview, .locked-photo, .photo-gate { min-height: 230px; border-radius: 18px; overflow: hidden; margin-top: 8px; margin-bottom: 24px; justify-content: center; align-items: center; background-color: rgba(46,155,214,0.08); }
.photo-gate-label { -unity-font-definition: url("project://database/Assets/Onsite/Fonts/BarlowCondensed-Light.ttf"); font-size: 48px; letter-spacing: 10px; color: #7FA3AB; }
.photo-gate-copy { padding: 30px; }
.feed-footer { justify-content: space-between; flex-wrap: wrap; }
.inline-metrics { flex-wrap: wrap; }
.hint-action { font-size: 20px; color: #7FE3FF; margin-left: auto; }
.letter-location, .post-location { font-size: 18px; color: #7FA3AB; margin-bottom: 18px; }
.letter-reactions { margin-bottom: 36px; }
.post-photo-tools { flex-wrap: wrap; margin-top: 18px; margin-bottom: 20px; }
.post-photo-tools > Button { margin-right: 18px; }
.notice-entry { flex-direction: column; align-items: stretch; white-space: normal; height: auto; padding: 24px 0; border-bottom-width: 1px; border-bottom-color: rgba(160,230,255,0.20); }
.notice-kicker { font-size: 17px; color: #7FA3AB; margin-right: 12px; }
.notice-entry.unread { padding-left: 20px; }
.notice-entry > .row { margin-bottom: 16px; }
.notice-dot { width: 6px; height: 6px; border-radius: 3px; background-color: #FFB24A; margin-right: 12px; }
.notice-title { font-size: 26px; margin-bottom: 14px; }
.notice-quote { font-size: 30px; margin-bottom: 16px; }
.letter-title { font-size: 42px; margin-top: 12px; margin-bottom: 28px; }
.letter-body { font-size: 28px; white-space: normal; margin-top: 22px; margin-bottom: 40px; -unity-paragraph-spacing: 14px; }
.guestbook-entry { border-bottom-width: 1px; border-bottom-color: rgba(160,230,255,0.18); margin-top: 14px; padding: 12px 0 24px; }
.guestbook-entry .body-copy { margin-top: 8px; margin-bottom: 4px; font-size: 25px; }
.privacy-warning { color: #FFB24A; border-left-width: 1px; border-left-color: #FFB24A; padding: 12px 18px; margin-top: 18px; margin-bottom: 24px; font-size: 22px; }
.segmented { flex-direction: row; flex-wrap: wrap; margin-top: 8px; margin-bottom: 26px; }
.segmented > Button { flex-grow: 1; margin-right: 12px; padding-left: 8px; padding-right: 8px; }
.stat-grid, .stats-grid { flex-wrap: wrap; margin-top: 20px; margin-bottom: 26px; }
.stat { width: 48%; padding: 12px 0; margin-right: 2%; margin-bottom: 18px; }
.stat-value { font-size: 52px; color: #EAFBFF; }
.stat-label { font-size: 18px; color: #7FA3AB; }
.archive-name { font-size: 44px; }
.archive-distance { font-size: 32px; margin-top: 14px; margin-bottom: 20px; color: #7FE3FF; }
.archive-entry { flex-direction: row; padding: 18px 0; border-bottom-width: 1px; border-bottom-color: rgba(160,230,255,0.18); }
.timeline-time { font-size: 22px; color: #7FA3AB; width: 100px; flex-shrink: 0; }
.timeline-copy { flex-grow: 1; flex-shrink: 1; }
.timeline-copy .body-copy { margin-top: 8px; margin-bottom: 6px; }
.avatar-stage { min-height: 330px; flex-shrink: 0; }
.me-screen .avatar-stage { min-height: 500px; }
.me-screen > .hud-panel > .fade-surface { opacity: 0.6; }
.screen.onboarding { left: 0; right: 0; top: 0; bottom: 0; max-width: none; padding: 34px 62px; }
.onboarding > .hud-panel { width: 100%; max-width: 1000px; align-self: center; }
.onboarding .panel-header, .onboarding .panel-rule { display: none; }
.onboarding > .hud-panel > .fade-surface { opacity: 0.6; }
.onboarding .wide-wordmark, .onboarding-wordmark {
    -unity-font-definition: url("project://database/Assets/Onsite/Fonts/BarlowCondensed-Light.ttf");
    font-size: 108px; letter-spacing: 30px; color: #EAFBFF; -unity-text-align: middle-center; flex-shrink: 0;
}
.onboarding .heading { -unity-text-align: middle-center; font-size: 30px; }
.onboarding-copy { color: #B5CDD3; -unity-text-align: middle-center; font-size: 22px; white-space: normal; margin-top: 12px; margin-bottom: 18px; }
.onboarding .onboarding-copy .body-copy { font-size: 22px; margin-top: 4px; margin-bottom: 4px; -unity-text-align: middle-center; }
.onboarding .avatar-stage { min-height: 350px; flex-grow: 1; }
.onboarding .unity-scroll-view__content-container { min-height: 100%; }
.onboarding .primary { margin-top: 24px; min-height: 76px; }
/* フィールドの四辺に配置する。 */
.hud-header { position: absolute; top: 28px; left: 36px; right: 36px; flex-direction: row; justify-content: space-between; }
.header-brand { flex-grow: 1; flex-shrink: 1; max-width: 720px; padding-right: 30px; }
.header-eyebrow { font-size: 14px; letter-spacing: 2px; color: #7FA3AB; margin-bottom: 2px; }
.header-band { height: 10px; min-height: 10px; margin-top: 2px; margin-bottom: 2px; }
.header-title-row { flex-direction: row; align-items: flex-end; }
.wordmark { -unity-font-definition: url("project://database/Assets/Onsite/Fonts/BarlowCondensed-Light.ttf"); font-size: 80px; letter-spacing: 20px; }
.header-japanese { font-size: 20px; color: #7FA3AB; margin-left: 16px; margin-bottom: 14px; }
.field-coordinates, .gps-label { font-size: 18px; color: #7FA3AB; margin-top: 6px; }
.demo-chip { color: #FFB24A; font-size: 16px; margin-left: 18px; }
.hud-level { width: 254px; flex-shrink: 0; padding: 10px 0 10px 22px; border-left-width: 1px; border-left-color: rgba(160,230,255,0.35); }
.hud-level .level { font-size: 48px; color: #EAFBFF; }
.xp-number { font-size: 32px; color: #EAFBFF; }
.xp-caption { font-size: 18px; color: #7FA3AB; }
.hud-level > .mono { font-size: 22px; margin-top: 4px; }
.hud-rail { position: absolute; left: 28px; top: 280px; width: 96px; }
.icon-button { position: relative; width: 94px; height: 76px; min-height: 76px; padding: 14px 22px; margin-bottom: 18px; align-items: center; justify-content: center; overflow: visible; }
.icon-button .line-icon { width: 33px; height: 33px; }
.icon-button:hover, .icon-button.selected { background-color: rgba(0,0,0,0); border-width: 0; }
.icon-button.selected .line-icon { color: #EAFBFF; }
.rail-label { display: none; position: absolute; left: 76px; top: 28px; font-size: 16px; letter-spacing: 2px; white-space: nowrap; }
.icon-button.selected .rail-label { display: flex; color: #7FE3FF; }
.rail-active-mark { position: absolute; left: 0; top: 22px; bottom: 22px; width: 2px; background-color: #EAFBFF; display: none; }
.icon-button.selected .rail-active-mark { display: flex; }
.rail-unread { position: absolute; top: 3px; right: 2px; flex-direction: row; align-items: center; }
.unread-dot { width: 5px; height: 5px; border-radius: 3px; background-color: #FFB24A; margin-right: 5px; }
.rail-badge { color: #FFB24A; font-size: 16px; }
.field-signals { position: absolute; right: 32px; top: 280px; width: 354px; max-height: 660px; padding: 12px 14px; }
.field-signals .panel-header { min-height: 34px; }
.field-signals .panel-heading { font-size: 25px; letter-spacing: 5px; }
.field-signals .panel-title { width: 100%; font-size: 18px; margin-left: 0; margin-top: 5px; }
.field-signals .panel-rule { margin-bottom: 8px; }
.field-signals.has-signals { height: 640px; }
.signal-list { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.signal-count { font-size: 14px; color: #7FA3AB; margin-bottom: 10px; }
.signal-row { flex-direction: row; align-items: center; min-height: 74px; padding: 10px 0; border-bottom-width: 1px; border-bottom-color: rgba(160,230,255,0.13); }
.signal-row.selected { background-color: rgba(255,178,74,0.07); }
.signal-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-left: 10px; }
.signal-title { font-size: 22px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.signal-copy .signal-meta { font-size: 15px; color: #7FA3AB; margin-top: 5px; }
.signal-distance { font-size: 24px; color: #7FE3FF; margin-left: 8px; }
.selected-drop { position: absolute; left: 150px; right: 36px; bottom: 180px; max-width: 850px; padding: 20px 24px; }
.selected-drop .panel-heading { font-size: 30px; letter-spacing: 7px; }
.selected-drop .panel-header { min-height: 42px; }
.selected-drop .panel-rule { margin-bottom: 12px; }
.selected-drop .panel-corners { display: flex; }
.selected-teaser { font-size: 36px; margin: 8px 0 20px; flex-grow: 1; flex-shrink: 1; }
.selected-title-row > .hex-icon { margin-right: 14px; }
.selected-approach { flex-wrap: wrap; }
.selected-approach .approach-caption { margin-left: 20px; flex-shrink: 1; }
.selected-identity { color: #7FA3AB; font-size: 19px; }
.selected-distance { font-size: 46px; color: #7FE3FF; }
.selected-distance-label { font-size: 16px; color: #7FA3AB; margin-left: 12px; }
.approach-caption { font-size: 19px; color: #7FA3AB; margin-top: 12px; }
.primary-action { min-height: 70px; margin-top: 18px; }
.selected-metrics { flex-wrap: wrap; }
.action-hints { flex-direction: row; justify-content: flex-end; flex-wrap: wrap; font-size: 19px; color: #7FA3AB; margin-top: 10px; }
.action-hints > * { margin-left: 18px; }
.hud-status { position: absolute; left: 36px; right: 36px; bottom: 28px; min-height: 95px; padding: 10px 4px; }
.hud-status > .fade-surface { opacity: 0.6; }
.hud-status .panel-header, .hud-status .panel-rule { display: none; }
.hud-status .panel-body > .row, .status-metrics { flex-grow: 1; justify-content: space-between; }
.status-metric { min-width: 160px; margin-right: 24px; }
.hud-status .section-label { font-size: 15px; letter-spacing: 2px; }
.hud-status .segment-bar { min-width: 140px; }
.status-count { font-size: 32px; color: #EAFBFF; }
.status-coordinates { font-size: 18px; color: #7FA3AB; margin-left: auto; }
.placement-bar { position: absolute; left: 150px; right: 36px; bottom: 180px; max-width: 850px; }
.placement-bar .row { justify-content: flex-end; flex-wrap: wrap; }
.placement-bar .row > Button { margin-left: 16px; }
.route-strip { position: absolute; left: 164px; top: 266px; max-width: 580px; padding: 8px 16px; }
.route-strip .panel-header, .route-strip .panel-rule { display: none; }
.route-actions { justify-content: space-between; }
.route-count { font-size: 18px; color: #FFB24A; }
.route-title { font-size: 23px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.route-strip .button { min-height: 40px; padding: 4px 12px; font-size: 18px; }
.route-strip .segment-bar { margin-top: 5px; margin-bottom: 5px; }
.data-table { flex-grow: 1; }
.table-header { min-height: 34px; border-bottom-width: 1px; border-bottom-color: rgba(160,230,255,0.35); padding-bottom: 8px; }
.table-header .table-cell { color: #7FA3AB; font-size: 16px; }
.table-row { min-height: 62px; padding: 12px 0; border-bottom-width: 1px; border-bottom-color: rgba(160,230,255,0.15); }
.table-row:hover, .table-row.selected { background-color: rgba(46,155,214,0.10); }
.table-row.selected Label { color: #7FE3FF; }
.row-triangle { width: 24px; flex-shrink: 0; font-size: 16px; color: #7FE3FF; }
.table-cell { width: 15%; flex-shrink: 0; padding-right: 8px; font-size: 21px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cell-0 { width: 10%; }
.cell-1 { width: auto; flex-grow: 1; flex-shrink: 1; min-width: 0; }
.hex-icon { width: 46px; height: 46px; flex-shrink: 0; justify-content: center; align-items: center; }
.hex-glyph { font-size: 23px; -unity-text-align: middle-center; }
.segment-bar { height: 5px; min-height: 5px; margin-top: 10px; margin-bottom: 10px; flex-shrink: 0; }
.line-icon { width: 30px; height: 30px; flex-shrink: 0; color: #7FE3FF; }
.metric-chip { flex-direction: row; align-items: center; margin-right: 22px; padding: 6px 0; }
.metric-chip .line-icon { width: 23px; height: 23px; margin-right: 10px; }
.metric-chip .mono { font-size: 22px; }
.world-tag { position: absolute; width: 36px; height: 36px; flex-direction: row; align-items: center; overflow: visible; }
.world-tag > .hex-icon { width: 36px; height: 36px; }
.world-tag-label { position: absolute; left: 32px; top: 0; flex-direction: row; align-items: center; width: 330px; max-width: 350px; min-height: 36px; padding: 0 8px; background-color: rgba(0,0,0,0); }
.world-tag.right-edge .world-tag-label { left: auto; right: 32px; }
.world-tag .tag-band { position: absolute; left: -8px; right: -12px; top: 0; bottom: 0; height: auto; min-height: 36px; margin: 0; }
.tag-teaser { max-width: 220px; flex-shrink: 1; padding: 6px 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 21px; color: #EAFBFF; text-shadow: 0 0 7px rgba(127,227,255,0.6); }
.distance-box { font-size: 22px; color: #7FE3FF; padding: 6px 4px; white-space: nowrap; flex-shrink: 0; }
.world-tag.selected .tag-teaser, .world-tag.selected .distance-box { color: #FFB24A; }
.world-tag .line-icon { width: 25px; height: 25px; }
.crosshair, .placement-crosshair { position: absolute; left: 50%; top: 50%; margin-left: -60px; margin-top: -60px; width: 120px; height: 120px; }
.confirm-cover { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(2,6,10,0.70); padding: 42px; }
.confirm-panel { width: 100%; max-width: 740px; padding: 28px 32px; }
.confirm-panel .panel-corners { display: flex; }
.confirm-panel .row { justify-content: flex-end; flex-wrap: wrap; }
.confirm-panel .row > Button { margin-left: 18px; }
.confirm-panel .body-copy { margin-bottom: 36px; }
.toast { position: absolute; left: 14%; right: 8%; bottom: 150px; flex-direction: row; align-items: center; padding: 18px 24px; background-color: rgba(4,10,16,0.72); border-left-width: 1px; border-left-color: #FFB24A; }
.toast-mark { color: #FFB24A; font-size: 34px; margin-right: 20px; }
.toast-kicker { color: #7FA3AB; font-size: 15px; margin-bottom: 6px; }
.toast-message { color: #EAFBFF; font-size: 24px; white-space: normal; }
.toast-hidden { opacity: 0; }
.sequence-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(2,6,10,0.76); }
.sequence-copy { position: absolute; left: 30px; right: 30px; top: 52%; align-items: center; }
.sequence-kicker { font-size: 18px; color: #7FA3AB; margin-bottom: 16px; }
.sequence-title { -unity-font-definition: url("project://database/Assets/Onsite/Fonts/BarlowCondensed-Light.ttf"); font-size: 112px; letter-spacing: 26px; color: #EAFBFF; -unity-text-align: middle-center; }
.sequence-complete .sequence-title { font-size: 90px; letter-spacing: 18px; }
.sequence-subtitle { font-size: 28px; margin-top: 18px; color: #7FE3FF; }
.sequence-reward { font-size: 21px; margin-top: 30px; color: #7FA3AB; }
/* 小さなウィンドウでは情報を畳み、操作領域を残す。 */
.narrow .screen { left: 112px; right: 22px; }
.narrow .hud-header { left: 24px; right: 24px; }
.narrow .wordmark { font-size: 64px; letter-spacing: 15px; }
.narrow .header-japanese { display: none; }
.narrow .hud-level { width: 204px; padding-left: 16px; }
.narrow .xp-number { font-size: 28px; }
.narrow .xp-caption { font-size: 16px; }
.narrow .field-coordinates { font-size: 16px; }
.narrow .field-signals { width: 300px; right: 24px; }
.narrow .field-signals .panel-title { display: none; }
.narrow .hud-rail { left: 14px; width: 80px; }
.narrow .icon-button { width: 80px; padding-left: 18px; padding-right: 18px; }
.narrow .rail-label { left: 60px; font-size: 14px; }
.narrow .selected-drop, .narrow .placement-bar { left: 112px; right: 24px; }
.narrow .panel-heading { font-size: 38px; letter-spacing: 7px; }
.narrow .panel-title { font-size: 18px; margin-left: 12px; }
.narrow .author-time { width: 100%; margin-left: 56px; padding-left: 0; }
.narrow .status-coordinates { display: none; }
.narrow .world-tag-label { width: 280px; }
.narrow .tag-teaser { max-width: 170px; }
.narrow .route-strip { left: 130px; max-width: 360px; }
.narrow .screen.onboarding { left: 0; right: 0; padding: 20px 26px; }
.narrow .onboarding .wide-wordmark { font-size: 88px; letter-spacing: 24px; }
.narrow .sequence-title { font-size: 86px; letter-spacing: 18px; }
.narrow .sequence-complete .sequence-title { font-size: 66px; letter-spacing: 12px; }
.compact .hud-header { top: 16px; }
.compact .wordmark { font-size: 52px; letter-spacing: 13px; }
.compact .header-eyebrow { font-size: 12px; }
.compact .header-japanese { font-size: 16px; margin-bottom: 8px; }
.compact .field-coordinates, .compact .gps-label { font-size: 16px; margin-top: 3px; }
.compact .hud-level { padding-top: 0; padding-bottom: 0; }
.compact .hud-level .level { font-size: 34px; }
.compact .hud-level > .mono { font-size: 18px; }
.compact .hud-level .xp-number { font-size: 26px; }
.compact .hud-level .xp-caption { font-size: 15px; }
.compact .hud-rail { top: 185px; }
.compact .icon-button { height: 58px; min-height: 58px; margin-bottom: 8px; }
.compact .rail-label { top: 19px; }
.compact .rail-active-mark { top: 16px; bottom: 16px; }
.compact .screen { top: 160px; bottom: 24px; }
.compact .panel-heading { font-size: 36px; letter-spacing: 7px; }
.compact .panel-header { min-height: 46px; }
.compact .hud-panel { padding-top: 14px; padding-bottom: 14px; }
.compact .field-signals { top: 190px; max-height: 370px; }
.compact .field-signals .panel-heading { font-size: 23px; letter-spacing: 4px; }
.compact .signal-row { min-height: 62px; }
.compact .signal-title { font-size: 19px; }
.compact .signal-copy .signal-meta { font-size: 14px; }
.compact .signal-distance { font-size: 21px; }
.compact .hud-status { bottom: 16px; min-height: 72px; }
.compact .hud-status .section-label { font-size: 14px; }
.compact .status-count { font-size: 26px; }
.compact .selected-drop, .compact .placement-bar { bottom: 124px; }
.compact .selected-drop .panel-heading { font-size: 26px; }
.compact .selected-teaser { font-size: 28px; margin-bottom: 10px; }
.compact .selected-distance { font-size: 36px; }
.compact .primary-action { min-height: 54px; margin-top: 12px; }
.compact .route-strip { top: 174px; }
.compact .map-hud.has-selection .field-signals { display: none; }
.compact .map-hud.has-route .field-signals { top: 260px; max-height: 280px; }

.compact .letter-title { font-size: 34px; }
.compact .letter-body { font-size: 25px; }
.compact .onboarding { top: 0; bottom: 0; padding: 16px 28px; }
.compact .onboarding .wide-wordmark { font-size: 72px; letter-spacing: 20px; }
.compact .onboarding .avatar-stage { min-height: 170px; }
.compact .onboarding .onboarding-copy .body-copy { font-size: 19px; }
.compact .picker { margin-top: 8px; margin-bottom: 12px; }
.compact .picker-option { min-height: 46px; padding-top: 7px; padding-bottom: 7px; }
.compact .onboarding .primary { min-height: 58px; margin-top: 14px; }
.landscape .screen { max-width: 1060px; right: 70px; }
.landscape .selected-drop { right: 420px; }
.landscape .field-signals { width: 340px; }
.landscape .route-strip { max-width: 580px; }
.landscape .me-screen .avatar-stage { min-height: 260px; }
.landscape.compact .map-hud.has-selection .field-signals { display: flex; }
.landscape.compact .selected-drop { right: 420px; }
.landscape.narrow .field-signals { width: 260px; }
.landscape.narrow .selected-drop { right: 310px; }
.landscape .onboarding .avatar-stage { min-height: 150px; }

/* 既定のボタンの灰色を消す（テーマより強く指定） */
.onsite-root .icon-button { background-color: rgba(0,0,0,0); border-width: 0; }

/* ===== スマホ縦持ち（.phone）：下にタブ、ページは全面、選んだ投稿は下からのシート ===== */
.phone .hud-header { top: 14px; left: 18px; right: 18px; }
.phone .header-eyebrow, .phone .header-japanese, .phone .gps-label, .phone .xp-caption { display: none; }
.phone .header-brand { max-width: none; padding-right: 12px; }
.phone .wordmark { font-size: 46px; letter-spacing: 12px; }
.phone .header-band { height: 8px; min-height: 8px; }
.phone .field-coordinates { font-size: 15px; margin-top: 2px; }
.phone .hud-level { width: 150px; padding: 2px 0 2px 14px; }
.phone .hud-level .level { font-size: 30px; }
.phone .hud-level .xp-number { font-size: 19px; }
.phone .hud-level > .mono { font-size: 15px; }

.phone .hud-rail {
    left: 0; right: 0; top: auto; bottom: 0; width: auto; height: 112px;
    flex-direction: row; justify-content: space-around; align-items: stretch;
    padding: 6px 4px 16px; background-color: rgba(3,8,12,0.86);
    border-top-width: 1px; border-top-color: rgba(160,230,255,0.22);
}
.phone .icon-button { width: auto; height: auto; min-height: 0; flex-grow: 1; flex-basis: 0; margin: 0; padding: 10px 0 0; flex-direction: column; justify-content: flex-start; }
.phone .icon-button .line-icon { width: 34px; height: 34px; }
.phone .rail-label { display: flex; position: relative; left: 0; top: 0; margin-top: 8px; font-size: 13px; letter-spacing: 1px; -unity-text-align: middle-center; color: #7FA3AB; }
.phone .icon-button.selected .rail-label { color: #7FE3FF; }
.phone .rail-active-mark { left: 28%; right: 28%; top: 0; bottom: auto; width: auto; height: 2px; }
.phone .rail-unread { top: 4px; right: 18%; }

.phone .field-signals { display: none; }
.phone .hud-status { left: 18px; right: 18px; bottom: 122px; min-height: 0; padding: 4px 0; }
.phone .status-coordinates { display: none; }
.phone .status-metric { min-width: 0; margin-right: 18px; flex-grow: 1; }
.phone .status-count { font-size: 24px; }
.phone .hud-status .segment-bar { min-width: 0; }

.phone .selected-drop, .phone .placement-bar {
    left: 0; right: 0; bottom: 112px; max-width: none; padding: 18px 22px 16px;
    background-color: rgba(3,8,12,0.90); border-top-width: 1px; border-top-color: rgba(127,227,255,0.45);
}
.phone .map-hud.has-selection .hud-status { display: none; }
.phone .selected-teaser { font-size: 30px; }
.phone .selected-distance { font-size: 38px; }
.phone .route-strip { left: 18px; right: 18px; top: 150px; max-width: none; background-color: rgba(3,8,12,0.75); }

.phone .screen { left: 0; right: 0; top: 0; bottom: 112px; max-width: none; padding: 22px 22px 0; background-color: rgba(3,8,12,0.94); }
.phone .screen.onboarding { bottom: 0; padding: 20px 24px; background-color: rgba(3,8,12,0); }
.phone .panel-heading { font-size: 38px; letter-spacing: 8px; }
.phone .panel-title { font-size: 17px; }
.phone .photo, .phone .letter-photo, .phone .post-preview { height: 420px; }
.phone .feed-card .heading, .phone .feed-teaser { font-size: 32px; }
.phone .letter-title { font-size: 36px; }
.phone .letter-body { font-size: 26px; }
.phone .toast { left: 18px; right: 18px; bottom: 300px; }
.phone .world-tag-label { width: 260px; }
.phone .tag-teaser { max-width: 160px; font-size: 19px; }
.phone .table-cell { font-size: 19px; }

/* 文章を読む画面は、地図の上でも読めるよう背景を沈める（地図はうっすら透ける） */
.screen { background-color: rgba(3,8,12,0.80); padding: 0 10px; }
.screen.onboarding { background-color: rgba(3,8,12,0); }

/* 知らせは上に出す（下の「ひらく」ボタンに重ねない） */
.toast { top: 210px; bottom: auto; left: 22%; right: 22%; }
.phone .toast { top: 130px; bottom: auto; left: 18px; right: 18px; }

/* 入力欄は、暗い背景の上でも「ここに書ける」と分かるように */
.field .unity-text-field__input { background-color: rgba(127,227,255,0.07); border-width: 1px; border-color: rgba(160,230,255,0.28); border-bottom-color: rgba(127,227,255,0.75); color: #EAFBFF; }
.field .unity-text-element { color: #EAFBFF; }

/* 押し込みは短く、指を離すと戻す。 */
.touch-feedback {
    scale: 1 1;
    transition-property: scale, background-color, color;
    transition-duration: 100ms;
    transition-timing-function: ease-out;
}
.unity-button.touch-feedback.touch-pressed, .unity-toggle.touch-feedback.touch-pressed {
    scale: 0.97 0.97;
    background-color: rgba(127,227,255,0.22);
    color: #EAFBFF;
}
.unity-button.primary.touch-feedback.touch-pressed { background-color: rgba(127,227,255,0.36); }
.rail-touch-glow {
    position: absolute; left: 12px; right: 12px; top: 3px; bottom: 3px;
    border-radius: 36px; background-color: rgba(127,227,255,0.07); opacity: 0;
    transition-property: opacity; transition-duration: 100ms; transition-timing-function: ease-out;
}
.rail-touch-glow-core {
    position: absolute; left: 7px; right: 7px; top: 7px; bottom: 7px;
    border-radius: 30px; background-color: rgba(127,227,255,0.15);
}
.icon-button.touch-pressed .rail-touch-glow, .icon-button.laser-flash .rail-touch-glow { opacity: 1; }
.onsite-root .icon-button.touch-pressed { background-color: rgba(127,227,255,0.08); }
.phone .rail-touch-glow { top: 1px; bottom: auto; height: 58px; left: 12%; right: 12%; }
.feedback-settings { flex-wrap: wrap; }
.feedback-settings > .unity-toggle { flex-grow: 1; min-width: 210px; margin-right: 24px; }

/* 撮影用の字幕。既存の画面には影響させない。 */
.tour-caption-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.tour-caption {
    position: absolute; left: 10%; right: 10%; bottom: 22px; max-width: 80%; background-color: rgba(3,8,12,0.55);
    align-items: center; padding: 14px 18px 0;
}
.tour-caption-main {
    width: 100%; color: #FFFFFF; font-size: 34px; white-space: normal;
    -unity-font-definition: url("project://database/Assets/Onsite/Fonts/ZenKakuGothicNew-Medium.ttf");
    -unity-text-align: middle-center; text-shadow: 0 0 10px rgba(127,227,255,0.70);
}
.tour-caption-small {
    width: 100%; margin-top: 12px; font-size: 18px; color: #C3EDF7;
    white-space: normal; -unity-text-align: middle-center;
}
.tour-caption > .tour-caption-band { width: 80%; height: 8px; min-height: 8px; margin-top: 16px; margin-bottom: 0; }
.tour-end-card {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    align-items: center; justify-content: center; padding: 36px;
    background-color: rgba(2,6,10,0.98);
}
.tour-end-title {
    max-width: 100%; font-size: 144px; letter-spacing: 32px; color: #EAFBFF;
    -unity-font-definition: url("project://database/Assets/Onsite/Fonts/BarlowCondensed-Light.ttf");
    -unity-text-align: middle-center; text-shadow: 0 0 16px rgba(127,227,255,0.40);
}
.tour-end-tagline { max-width: 100%; margin-top: 26px; font-size: 34px; letter-spacing: 4px; -unity-text-align: middle-center; }
.tour-end-address { max-width: 100%; margin-top: 60px; font-size: 20px; color: #7FA3AB; -unity-text-align: middle-center; }
.compact .tour-caption { bottom: 112px; }
.phone .tour-caption { bottom: 225px; padding-left: 0; padding-right: 0; }
.phone .tour-caption-main { font-size: 32px; }
.phone .tour-caption-small { font-size: 16px; }
.phone .tour-end-title { font-size: 96px; letter-spacing: 22px; }
.phone .tour-end-tagline { font-size: 30px; letter-spacing: 2px; }
.phone .tour-end-address { font-size: 18px; }

.phone .tour-caption { bottom: 130px; }

/* ===== 画面を静かに：地図が主役。出すのは印・選んだ投稿・知らせだけ ===== */
.field-signals { display: none; }
.header-eyebrow, .header-japanese, .gps-label, .header-band { display: none; }
.wordmark { font-size: 44px; letter-spacing: 12px; }
.field-coordinates { font-size: 14px; margin-top: 0; }
.hud-level { width: auto; border-left-width: 0; padding: 0; align-items: flex-end; }
.hud-level .xp-number, .hud-level .xp-caption, .hud-level .trail-distance, .hud-level .segment-bar { display: none; }
.hud-level .level { font-size: 26px; color: #7FE3FF; }
.phone .wordmark { font-size: 36px; letter-spacing: 10px; }
.phone .hud-level .level { font-size: 22px; }
