# コピーして .env.local を作り、値を入れてください（.env.local はコミットされません）
# Firebase コンソール > プロジェクトの設定 > マイアプリ（ウェブ）の firebaseConfig
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=kokodake-t009
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Google Cloud コンソール > Google Maps Platform > 認証情報 で作った API キー
# （HTTP リファラーを本番ドメインと localhost に制限してください）
VITE_GOOGLE_MAPS_API_KEY=
# Map ID（未設定なら DEMO_MAP_ID を使います）
VITE_GOOGLE_MAPS_MAP_ID=

# ローカルのエミュレーターにつなぐときだけ true
VITE_USE_EMULATORS=false
